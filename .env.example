# Docker: which host address the published ports listen on.
# 127.0.0.1 = only this computer; 0.0.0.0 = every network interface (LAN/Internet)
PUBLISH_IP=127.0.0.1

# Server
SERVER_BIND=0.0.0.0
SERVER_PORT=12321

# Rcon
RCON_BIND=0.0.0.0
RCON_PORT=12309

# Mus
MUS_BIND=0.0.0.0
MUS_PORT=12322

# Database
MYSQL_HOSTNAME=mariadb
MYSQL_PORT=3306
MYSQL_USER=kepler
MYSQL_PASSWORD=verysecret
MYSQL_DATABASE=kepler
MARIADB_ROOT_PASSWORD=veryverysecret

# Logging
LOG_RECEIVED_PACKETS=false
LOG_SENT_PACKETS=false

# Console
DEBUG=false

# Client on Linux (compose.client.yml + tools/linux/setup-client.sh)
# Host name the browser uses to reach this server, and the ports for the
# web files and the WebSocket bridges used by the DirPlayer emulator.
CLIENT_SERVER_HOST=localhost
CLIENT_WEB_PORT=8087
WS_GAME_PORT=12331
WS_MUS_PORT=12332
